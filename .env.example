# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- App environment: development | testing | production ---
# In production, ProductionConfig REFUSES to boot without a real
# SECRET_KEY and DATABASE_URL (app/config/config.py) — this is a
# deliberate fail-fast safety check, not a bug if you see it.
APP_ENV=development
FLASK_APP=run.py

# --- Flask ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-value

# --- Database ---
# Local dev default (SQLite) is used automatically if unset — see app/config/config.py.
# REQUIRED in production. SQLite works for a single-server deployment;
# for multiple Gunicorn workers under real concurrent load, use Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/ostutorllm
# DATABASE_URL=sqlite:////absolute/path/to/database/dev.db

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate limiting (reserved) ---
RATE_LIMIT_PER_MINUTE=30

PORT=5000

# --- Part 3.10: Faculty file uploads + DB backups ---
# UPLOAD_FOLDER=/absolute/path/to/uploads/content
# BACKUP_FOLDER=/absolute/path/to/uploads/backups
MAX_UPLOAD_SIZE_MB=10

# --- AI Tutor Engine (Part 3.6) ---
# One of: openai | deepseek | ollama_qwen | ollama_llama | mock
# "mock" (the default) requires no API key or network access — safe for
# local development, demos, and this project's automated tests.
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_QWEN_MODEL=qwen2.5
OLLAMA_LLAMA_MODEL=llama3.1

AI_TEMPERATURE=0.4
AI_MAX_TOKENS=500
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1.5
AI_MAX_HISTORY_TURNS=12
