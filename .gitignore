# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.local
.env.*.local

# Databases & SQLite temporary artifacts
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
instance/

# Pytest, coverage & testing artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
tests/reports/*
!tests/reports/.gitkeep

# Runtime logs & user uploads (track directories via .gitkeep)
logs/*
!logs/.gitkeep
uploads/*
!uploads/.gitkeep

# IDEs & OS metadata
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
